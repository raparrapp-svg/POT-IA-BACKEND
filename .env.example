# ============================================================
# POT-IA Backend — Variables de entorno
# Copia este archivo como .env y ajusta los valores
# ============================================================

# --- Base de datos PostgreSQL + PostGIS ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pot_ia
DB_USER=postgres
DB_PASSWORD=tu_password_aqui

# URL completa (se construye automáticamente, pero puedes sobrescribir)
# DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/pot_ia

# --- Claude API (Anthropic) ---
# Obtén tu key en: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# --- Servicios ArcGIS REST ---
IDEAM_FEATURE_SERVER=https://visualizador.ideam.gov.co/gisserver/rest/services/Amenaza_Ambiental/FeatureServer
IGAC_CATASTRO_URL=https://sigi.igac.gov.co/habilitacion/rest/services/sinic/ric/MapServer/0
RUNAP_URL=https://mapas.parquesnacionales.gov.co/arcgis/rest/services/pnn/runap/MapServer/0
SGC_AMENAZA_URL=https://srvags.sgc.gov.co/arcgis/rest/services/Amenaza_Movimientos_en_Masa/amenaza_mm_nacional/MapServer/0

# --- Configuración general ---
APP_NAME=POT-IA Backend
APP_VERSION=1.0.0
DEBUG=true
# Orígenes permitidos para el frontend (CORS)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5500

# --- Caché ---
# Tiempo en segundos que se guardan los resultados de consultas ArcGIS
CACHE_TTL_SECONDS=3600
